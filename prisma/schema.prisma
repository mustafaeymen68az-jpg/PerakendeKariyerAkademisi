generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String           @id @default(uuid())
  name           String
  email          String           @unique
  password       String
  role           String           // "ADMIN" | "TRAINER" | "COMPANY_MANAGER" | "DEPT_MANAGER" | "PARTICIPANT"
  lastLoginAt    DateTime?        // Son giriş zamanı - 7 gün kontrolü için
  surname        String?
  phone          String?
  companyName    String?
  sectorChannel  String?
  sectorDetail   String?
  city           String?
  title          String?
  companyId      String?
  company        Company?         @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id])
  departmentId   String?
  department     Department?      @relation(fields: [departmentId], references: [id])
  enrollments    Enrollment[]
  certificates   Certificate[]
  kpiResults     KpiResult[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  swotAnalyses   SwotAnalysis[]
  sentMessages   InstructorMessage[] @relation("SentInstructorMessages")
  education      String?          // Nerede okuduğu / Eğitim geçmişi
  experience     String?          // Kariyer geçmişi & Deneyimler
  bio            String?          // Biyografi özeti
  avatar         String?          // Profil fotoğrafı URL
  cvUrl          String?          // Özgeçmiş döküman bağlantısı
  assignedCourses String?         // Atadığı veya uzmanı olduğu eğitimlerin kaydı

  // Yeni Tanımlanan Alanlar
  customerType           String?                 @default("INDIVIDUAL") // "INDIVIDUAL" | "CORPORATE"
  professionalPositionId String?
  professionalPosition   ProfessionalPosition?   @relation("UserPosition", fields: [professionalPositionId], references: [id])
  targetPositionId       String?
  targetPosition         ProfessionalPosition?   @relation("UserTargetPosition", fields: [targetPositionId], references: [id])
  careerGoalId           String?
  careerGoal             CareerGoal?             @relation("UserCareerGoal", fields: [careerGoalId], references: [id])
  customPosition         String?
  storeRegion            String?
  accountStatus          String                  @default("ACTIVE") // "ACTIVE" | "PENDING" | "SUSPENDED"
  managerId              String?
  onboardingCompleted    Boolean                 @default(false)
  userRoles              UserRole[]
  analyticsEvents        AnalyticsEvent[]
  siteVisits             SiteVisit[]

  careerProfile            UserCareerProfile?
  competencyAssessments    UserCompetencyAssessment[]
  careerDevelopmentPlan    CareerDevelopmentPlan?
  userFieldTasks           UserFieldTask[]
  mentorOf                 Mentorship[]                @relation("MentorRelations")
  menteeOf                 Mentorship[]                @relation("MenteeRelations")
  readinessScoreRecord     ReadinessScore?
  coachCheckIns            DigitalCoachCheckIn[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model SystemRole {
  id          String     @id @default(uuid())
  name        String     @unique // "STUDENT" | "INSTRUCTOR" | "ORGANIZATION_ADMIN" | "PLATFORM_ADMIN"
  description String?
  userRoles   UserRole[]
}

model UserRole {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      SystemRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, roleId])
}

model CareerPath {
  id          String                 @id @default(uuid())
  name        String                 @unique // e.g. "Mağaza Operasyonları", "Taze Gıda", "Genel Merkez & Uzmanlık"
  category    String                 @default("STORE_OPERATIONS") // "STORE_OPERATIONS" | "FRESH_FOOD" | "HEADQUARTERS" | "SPECIALIST"
  description String?
  status      String                 @default("ACTIVE") // "ACTIVE" | "PASSIVE"
  positions   ProfessionalPosition[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model ProfessionalPosition {
  id                  String                 @id @default(uuid())
  name                String
  group               String                 // "STORE_OPERATIONS" | "FRESH_FOOD" | "STORE_MANAGEMENT" | "FIELD_MANAGEMENT" | "HEADQUARTERS" | "EXECUTIVE" | "OTHER"
  careerPathId        String?
  careerPath          CareerPath?            @relation(fields: [careerPathId], references: [id])
  departmentId        String?
  department          Department?            @relation(fields: [departmentId], references: [id])
  careerLevel         Int                    @default(1)
  nextPositionId      String?
  nextPosition        ProfessionalPosition?  @relation("PositionNext", fields: [nextPositionId], references: [id])
  previousPositions   ProfessionalPosition[] @relation("PositionNext")
  active              Boolean                @default(true)
  description         String?
  responsibilities    String?                // JSON string list
  prerequisites       String?                // JSON string list
  
  users               User[]                 @relation("UserPosition")
  targetUsers         User[]                 @relation("UserTargetPosition")
  recommendationRules RecommendationRule[]   @relation("RulePosition")
  targetRules         RecommendationRule[]   @relation("RuleTargetPosition")
  requirements        PositionRequirement[]
  fieldTasks          FieldTask[]
  
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

model PositionRequirement {
  id           String               @id @default(uuid())
  positionId   String
  position     ProfessionalPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency           @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  targetLevel  Int                  @default(3) // 1-5 scale
  required     Boolean              @default(true)
  weight       Float                @default(1.0)
  createdAt    DateTime             @default(now())

  @@unique([positionId, competencyId])
}

model UserCareerProfile {
  id                              String    @id @default(uuid())
  userId                          String    @unique
  user                            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentPositionId               String?
  nextTargetPositionId            String?
  longTermTargetPositionId        String?
  totalExperienceMonths           Int       @default(12)
  currentPositionExperienceMonths Int       @default(6)
  weeklyLearningHours             Int       @default(5)
  preferredLearningStyle          String    @default("SAHA") // "VIDEO" | "OKUMA" | "CANLI" | "SAHA"
  careerGoalType                  String    @default("VERTICAL") // "EXPERT" | "VERTICAL" | "MANAGER" | "DEPARTMENT" | "FRESH_FOOD" | "HQ" | "MENTOR" | "GENERAL_MANAGEMENT" | "UNDECIDED"
  onboardingCompleted             Boolean   @default(false)
  managerShareConsent             Boolean   @default(true)
  currentStore                    String?
  region                          String?
  managedEmployeesCount           Int       @default(0)
  shiftManagementExp              Boolean   @default(false)
  operatedSystems                 String?   // JSON string array
  previousPositions               String?   // Text summary
  orientationQuizScore            Int?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
}

model Competency {
  id           String                     @id @default(uuid())
  name         String                     @unique
  category     String                     // "TEKNIK" | "DAVRANISAL" | "LIDERLIK" | "MUSTERI" | "KPI" | "SAHA"
  description  String?
  active       Boolean                    @default(true)
  requirements PositionRequirement[]
  assessments  UserCompetencyAssessment[]
  fieldTasks   FieldTask[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

model UserCompetencyAssessment {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  competencyId    String
  competency      Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  score           Int        // 1-5 scale
  source          String     @default("SELF") // "SELF" | "MANAGER" | "EXAM" | "TASK" | "SYSTEM"
  evaluatorUserId String?
  assessmentDate  DateTime   @default(now())
  evidenceId      String?
  notes           String?
  createdAt       DateTime   @default(now())
}

model CareerDevelopmentPlan {
  id                       String                @id @default(uuid())
  userId                   String                @unique
  user                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetPositionId         String?
  longTermTargetPositionId String?
  startDate                DateTime              @default(now())
  targetDate               DateTime?
  status                   String                @default("AKTIF") // "AKTIF" | "TAMAMLANDI" | "REVIZE"
  mentorId                 String?
  managerApprovalStatus    String                @default("ONAYLANDI") // "BEKLIYOR" | "ONAYLANDI" | "REVIZE"
  weeklyHours              Int                   @default(5)
  notes                    String?
  items                    DevelopmentPlanItem[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
}

model DevelopmentPlanItem {
  id          String                @id @default(uuid())
  planId      String
  plan        CareerDevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemType    String                // "TEKNIK" | "DAVRANISAL" | "KOCLUK" | "SAHA_GOREVI" | "EGITIM" | "MENTOR_GORUSMESI"
  referenceId String?
  title       String
  description String?
  required    Boolean               @default(true)
  dueDate     DateTime?
  status      String                @default("BEKLIYOR") // "BEKLIYOR" | "DEVAM_EDIYOR" | "TAMAMLANDI"
  weight      Float                 @default(1.0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model FieldTask {
  id                   String               @id @default(uuid())
  title                String
  description          String
  competencyId         String?
  competency           Competency?          @relation(fields: [competencyId], references: [id])
  targetPositionId     String?
  targetPosition       ProfessionalPosition? @relation(fields: [targetPositionId], references: [id])
  evidenceRequirements String?              // JSON string array e.g. ["PHOTO", "PDF", "REPORT"]
  evaluatorRole        String               @default("MANAGER") // "MANAGER" | "MENTOR" | "TRAINER"
  active               Boolean              @default(true)
  userTasks            UserFieldTask[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model UserFieldTask {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldTaskId   String
  fieldTask     FieldTask @relation(fields: [fieldTaskId], references: [id], onDelete: Cascade)
  assignedAt    DateTime  @default(now())
  dueDate       DateTime?
  status        String    @default("BEKLIYOR") // "BEKLIYOR" | "INCELEMEDE" | "TAMAMLANDI" | "REDDEDILDI"
  evidence      String?   // JSON string or file path / notes
  evaluatorId   String?
  score         Int?      // 0-100
  feedback      String?
  reflection    String?   // JSON string of reflection Q&A
  submittedAt   DateTime?
  evaluatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Mentorship {
  id          String          @id @default(uuid())
  mentorId    String
  mentor      User            @relation("MentorRelations", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId    String
  mentee      User            @relation("MenteeRelations", fields: [menteeId], references: [id], onDelete: Cascade)
  startDate   DateTime        @default(now())
  endDate     DateTime?
  status      String          @default("AKTIF") // "AKTIF" | "TAMAMLANDI" | "PASIF"
  meetings    MentorMeeting[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model MentorMeeting {
  id            String     @id @default(uuid())
  mentorshipId  String
  mentorship    Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  agenda        String?
  employeeNotes String?
  mentorNotes   String?
  actionItems   String?    // JSON string array
  privacyLevel  String     @default("PRIVATE") // "PRIVATE" | "MANAGER_READ" | "PUBLIC"
  completedAt   DateTime?
  status        String     @default("PLANLANDI") // "PLANLANDI" | "TAMAMLANDI" | "IPTAL"
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model ReadinessScore {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetPositionId    String?
  technicalScore      Float    @default(0) // %20
  fieldScore          Float    @default(0) // %20
  competencyScore     Float    @default(0) // %20
  kpiScore            Float    @default(0) // %15
  managerScore        Float    @default(0) // %10
  mentorScore         Float    @default(0) // %10
  planAdherenceScore  Float    @default(0) // %5
  totalScore          Float    @default(0)
  strengths           String?  // JSON string array
  opportunities       String?  // JSON string array
  recommendedActions  String?  // JSON string array
  calculatedAt        DateTime @default(now())
  calculationVersion  String   @default("v1.0")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DigitalCoachCheckIn {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber  Int
  dayOfWeek   String   // "MONDAY" | "WEDNESDAY" | "FRIDAY" | "MONTH_END"
  prompt      String
  response    String?
  blockerType String?  // "TIME" | "MANAGER_SUPPORT" | "NOT_UNDERSTOOD" | "TECHNICAL" | "COMPLETED" | "OTHER"
  actionItems String?  // JSON string
  createdAt   DateTime @default(now())
}

model CareerGoal {
  id                  String                 @id @default(uuid())
  title               String
  description         String?
  users               User[]                 @relation("UserCareerGoal")
  recommendationRules RecommendationRule[]
  createdAt           DateTime               @default(now())
}

model RecommendationRule {
  id                    String                @id @default(uuid())
  title                 String
  positionId            String?
  position              ProfessionalPosition? @relation("RulePosition", fields: [positionId], references: [id])
  targetPositionId      String?
  targetPosition        ProfessionalPosition? @relation("RuleTargetPosition", fields: [targetPositionId], references: [id])
  departmentId          String?
  department            Department?           @relation(fields: [departmentId], references: [id])
  careerGoalId          String?
  careerGoal            CareerGoal?           @relation(fields: [careerGoalId], references: [id])
  recommendedTrainingIds String               // JSON array string
  recommendedPathTitle  String?
  competencies          String?               // JSON array or comma separated
  estimatedHours        Int                   @default(16)
  moduleCount           Int                   @default(5)
  active                Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model CorporatePackage {
  id          String    @id @default(uuid())
  name        String
  maxUsers    Int       @default(50)
  maxStores   Int       @default(10)
  price       Float?
  features    String?   // JSON string
  active      Boolean   @default(true)
  companies   Company[]
  createdAt   DateTime  @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventName String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  metadata  String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())
}

model Company {
  id            String            @id @default(uuid())
  name          String
  logo          String?
  industry      String?
  subCount      Int               @default(0) // Şube sayısı
  employeeCount Int               @default(0) // Çalışan sayısı
  packageId     String?
  package       CorporatePackage? @relation(fields: [packageId], references: [id])
  licenseLimit  Int               @default(10)
  status        String            @default("ACTIVE") // "ACTIVE" | "PENDING_DEMO" | "EXPIRED"
  branches      Branch[]
  users         User[]
  requests      TrainingRequest[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id                  String               @id @default(uuid())
  name                String               @unique
  slug                String               @unique
  description         String?
  trainings           Training[]           // Many-to-many
  users               User[]
  positions           ProfessionalPosition[]
  recommendationRules RecommendationRule[]
  kpis                KpiDefinition[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  trainings   Training[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Training {
  id               String            @id @default(uuid())
  title            String
  slug             String            @unique
  duration         Int               // Saat cinsinden
  level            String            // "TEMEL" | "GOREV" | "YONETICI" | "ILERI_YONETIM" | "STRATEJIK"
  format           String            // "ONLINE" | "YUZ_YUZE" | "HIBRIZ"
  type             String            // "KURUMSAL" | "BIREYSEL" | "HER_IKISI"
  targetAudience   String?
  description      String?
  objectives       String?           // Eğitimin amacı
  content          String?           // Eğitim içeriği
  achievements     String?           // Kazanımlar
  prerequisites    String?           // Ön koşullar
  examMethod       String?           // Ölçme değerlendirme yöntemi
  kpis             String?           // Takip edilecek KPI'lar
  trainerId        String?
  trainer          Trainer?          @relation(fields: [trainerId], references: [id])
  date             DateTime?
  location         String?
  capacity         Int?
  status           String            @default("AKTIF") // "AKTIF" | "PLANLANDI" | "TAMAMLANDI"
  certStatus       Boolean           @default(true)
  coverImage       String?
  tags             String?           // Virgülle ayrılmış etiketler
  published        Boolean           @default(true)
  
  departments      Department[]      // Many-to-many
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id])
  programModules   ProgramModule[]
  sessions         TrainingSession[]
  enrollments      Enrollment[]
  certificates     Certificate[]
  documents        Document[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model TrainingProgram {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  objective        String?
  targetAudience   String?
  totalDuration    Int             @default(0) // Saat
  certRequirements String?
  examMethod       String?
  kpis             String?
  modules          ProgramModule[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ProgramModule {
  id         String          @id @default(uuid())
  programId  String
  program    TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  trainingId String
  training   Training        @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  order      Int             // Sıralama
}

model Trainer {
  id          String     @id @default(uuid())
  name        String
  title       String?
  bio         String?
  experience  String?
  specialty   String?
  linkedin    String?
  image       String?
  trainings   Training[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model TrainingSession {
  id                String       @id @default(uuid())
  trainingId        String
  training          Training     @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  date              DateTime
  time              String?
  format            String
  location          String?
  capacity          Int
  remainingCapacity Int
  status            String       @default("ACIK") // "ACIK" | "DOLU" | "IPTAL"
  enrollments       Enrollment[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Enrollment {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingId String
  training   Training         @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    TrainingSession? @relation(fields: [sessionId], references: [id])
  status     String           @default("DEVAM_EDIYOR") // "DEVAM_EDIYOR" | "TAMAMLANDI" | "IPTAL"
  progress   Int              @default(0) // 0-100
  examScore  Int?
  kpiScore   Int?
  feedback   String?
  evaluation Evaluation?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Exam {
  id         String     @id @default(uuid())
  title      String
  trainingId String?    @unique
  questions  Question[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Question {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  text      String
  options   String   // JSON string or serialized array (Option A|Option B|Option C|Option D)
  answer    String   // Correct option (e.g. "A" or text)
}

model Certificate {
  id         String   @id @default(uuid())
  code       String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingId String
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  issueDate  DateTime @default(now())
  status     String   @default("AKTIF") // "AKTIF" | "GECERSIZ"
  pdfPath    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TrainingRequest {
  id            String   @id @default(uuid())
  name          String
  companyName   String
  title         String?  // Katılımcının unvanı
  phone         String
  email         String
  city          String
  subCount      Int?
  employeeCount Int?
  department    String?
  training      String?
  count         Int?     // Katılımcı sayısı
  format        String?  // ONLINE | YUZ_YUZE
  date          DateTime?
  notes         String?
  gdpr          Boolean  @default(false)
  status        String   @default("BEKLIYOR") // "BEKLIYOR" | "INCELEMEDE" | "ONAYLANDI" | "REDDEDILDI"
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())
}

model Evaluation {
  id           String     @id @default(uuid())
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  score        Int        // 1-5 yıldız
  comments     String?
  createdAt    DateTime   @default(now())
}

model KpiDefinition {
  id           String      @id @default(uuid())
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  unit         String      // "TL" | "%" | "Adet" | "Gün" | "Saat"
  target       String?
  description  String?
  results      KpiResult[]
}

model KpiResult {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kpiId       String
  kpi         KpiDefinition @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  valueBefore Float
  valueAfter  Float
  date        DateTime      @default(now())
  notes       String?
}

model Document {
  id         String   @id @default(uuid())
  trainingId String
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  name       String
  type       String   // "PDF" | "PPTX" | "XLSX" | "VIDEO"
  url        String
  size       String?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model SwotAnalysis {
  id          String   @id @default(uuid())
  userId      String   // Öğrenci ID
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainerName String   @default("Kariyer Akademisi Eğitmeni")
  strengths   String   // Güçlü Yönler (JSON or text)
  weaknesses  String   // Zayıf Yönler (JSON or text)
  opportunities String // Fırsatlar (JSON or text)
  threats     String   // Tehditler (JSON or text)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InstructorMessage {
  id         String   @id @default(uuid())
  trainerId  String
  trainer    User     @relation("SentInstructorMessages", fields: [trainerId], references: [id], onDelete: Cascade)
  studentId  String?  // Null ise tüm öğrencilere
  type       String   @default("MESAJ") // "MESAJ" | "SORU" | "DUYURU"
  title      String
  content    String
  createdAt  DateTime @default(now())
}

model CourseAssignment {
  id          String   @id @default(uuid())
  trainerId   String
  department  String
  courseTitle String
  studentName String
  dueDate     DateTime?
  status      String   @default("ATANDI") // "ATANDI" | "TAMAMLANDI" | "GECIKTI"
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TalentPoolRequest {
  id             String   @id @default(uuid())
  companyName    String
  hrName         String
  hrEmail        String
  candidateName  String
  candidateDept  String
  candidateScore Int
  status         String   @default("BEKLIYOR") // "BEKLIYOR" | "ILETISIME_GECILDI" | "TAMAMLANDI"
  createdAt      DateTime @default(now())
}

model CareerOrientationTest {
  id             String                          @id @default(uuid())
  title          String                          @default("Perakende Kariyer Yönelim Testi")
  description    String?                         @default("İlgi alanlarını, almak istediğin sorumlulukları ve gelecekte yapmak istediğin işleri keşfet.")
  version        String                          @default("v1.0")
  active         Boolean                         @default(true)
  cooldownMonths Int                             @default(6)
  questions      CareerOrientationQuestion[]
  attempts       UserCareerOrientationAttempt[]
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
}

model CareerOrientationQuestion {
  id             String                     @id @default(uuid())
  testId         String
  test           CareerOrientationTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionNumber Int
  text           String
  weight         Float                      @default(1.0) // 1.5x for Q2, Q5, Q7, Q9, Q15, Q16, Q20
  isTieBreaker   Boolean                    @default(false)
  active         Boolean                    @default(true)
  options        CareerOrientationOption[]
  answers        UserCareerOrientationAnswer[]
  createdAt      DateTime                   @default(now())
}

model CareerOrientationOption {
  id               String                    @id @default(uuid())
  questionId       String
  question         CareerOrientationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionCode       String                    // "A" | "B" | "C" | "D" | "E" | "F" | "G"
  text             String
  targetPositionId String?                   // "TAKIM_LIDERI" | "MUDUR_YRD" | "MAGAZA_MUDURU" | "BOLGE_MUDURU" | "OPERASYON_DIREKTORU" | "COO" | "CEO"
  directScore      Float                     @default(3.0)
  adjacentScore    Float                     @default(1.0)
  answers          UserCareerOrientationAnswer[]
  createdAt        DateTime                  @default(now())
}

model UserCareerOrientationAttempt {
  id              String                       @id @default(uuid())
  userId          String
  testId          String
  test            CareerOrientationTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  testVersion     String                       @default("v1.0")
  startedAt       DateTime                     @default(now())
  completedAt     DateTime?
  currentQuestion Int                          @default(1)
  status          String                       @default("IN_PROGRESS") // "IN_PROGRESS" | "TIE_BREAKER" | "COMPLETED" | "ABANDONED"
  answers         UserCareerOrientationAnswer[]
  result          CareerOrientationResult?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
}

model UserCareerOrientationAnswer {
  id          String                       @id @default(uuid())
  attemptId   String
  attempt     UserCareerOrientationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    CareerOrientationQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId    String
  option      CareerOrientationOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  scoreData   String?                      // JSON string of calculated position scores for this question
  answeredAt  DateTime                     @default(now())

  @@unique([attemptId, questionId])
}

model CareerOrientationResult {
  id                    String                       @id @default(uuid())
  attemptId             String                       @unique
  attempt               UserCareerOrientationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  nextStepPositionId    String                       // e.g. "Takım Lideri / Kıdemli Satış"
  longTermPositionId    String                       // e.g. "Bölge / Saha Müdürü"
  alternativePositionId String                       // e.g. "Mağaza Müdürü"
  positionScores        String                       // JSON object string of all position scores
  resultSummary         String?                      // Custom feedback narrative text
  calculatedAt          DateTime                     @default(now())
  calculationVersion    String                       @default("v1.0")
  createdAt             DateTime                     @default(now())
}

model SiteVisit {
  id           String   @id @default(uuid())
  sessionId    String
  userId       String?
  userEmail    String?
  userName     String?
  userRole     String?
  isRegistered Boolean  @default(false)
  ipAddress    String?
  userAgent    String?
  deviceType   String?  // "Masaüstü" | "Mobil" | "Tablet"
  browser      String?  // "Chrome" | "Safari" | "Firefox" | "Edge" vb.
  os           String?  // "Windows" | "iOS" | "Android" | "Mac" vb.
  path         String   // E.g. "/", "/egitimler", "/kariyer-pusulasi"
  pageTitle    String?
  referrer     String?
  city         String?
  country      String?
  visitCount   Int      @default(1)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@index([isRegistered])
  @@index([lastActiveAt])
  @@index([createdAt])
}
